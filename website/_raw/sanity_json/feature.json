        "_type": "block",
        "children": [
          {
            "_key": "a469292dfabd",
            "_type": "span",
            "marks": [
              "em"
            ],
            "text": "\u201cWhat were our top-selling products last week?\u201d"
          }
        ],
        "level": 1,
        "listItem": "bullet",
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "39fbe38de273",
        "_type": "block",
        "children": [
          {
            "_key": "51165d773aa4",
            "_type": "span",
            "marks": [
              "em"
            ],
            "text": "\u201cShow me revenue by ad campaign for Q2.\u201d"
