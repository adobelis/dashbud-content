    "imageAlt": "The user types \"In-app conversion by screen\" and sees a bar chart with conversion percentages.",
    "longDescription": [
      {
        "_key": "30529ffc3cae",
        "_type": "block",
        "children": [
          {
            "_key": "25c3f092ec15",
            "_type": "span",
            "marks": [],
            "text": "Dashbud lets you query your data like you're talking to a teammate. No technical syntax, no waiting in line for a report \u2014 just clear answers, fast."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "bb02faccc4e1",
        "_type": "block",
        "children": [
          {
            "_key": "583ce53bdd44",
            "_type": "span",
            "marks": [],
            "text": "Traditionally, creating a report means one of two things:"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "c4c30a4f6d3d",
        "_type": "block",
        "children": [
          {
            "_key": "244957db7b3e",
            "_type": "span",
            "marks": [],
            "text": "Writing SQL \u2014 which requires significant technical skill"
          }
        ],
        "level": 1,
        "listItem": "bullet",
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "57101d5ce4bf",
        "_type": "block",
        "children": [
          {
            "_key": "ceba9bf29ca6",
            "_type": "span",
            "marks": [],
            "text": "Or slogging through a point-and-click interface in a BI tool \u2014 which is often slow, glitchy, and confusing"
          }
        ],
        "level": 1,
        "listItem": "bullet",
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "ba0058001e6f",
        "_type": "block",
        "children": [
          {
            "_key": "2cca821755a0",
            "_type": "span",
            "marks": [],
            "text": "Dashbud removes both barriers. You simply ask a question \u2014 and Dashbud generates accurate, visual answers on the fly. For example:"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
