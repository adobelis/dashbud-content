      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "db1649ab63f7",
      "_type": "block",
      "children": [
        {
          "_key": "4bde01f77fdc",
          "_type": "span",
          "marks": [],
          "text": "This Agreement remains in effect until terminated. You may terminate at any time by ceasing use. Evolytix may suspend or terminate your license for violation of this Agreement. Upon termination, you must cease all use of Dashbud."
