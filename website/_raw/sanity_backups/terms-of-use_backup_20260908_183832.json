        {
          "_key": "5f12710e9e60",
          "_type": "span",
          "marks": [],
          "text": "3. User Data and Privacy"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "a900fce260d9",
      "_type": "block",
      "children": [
        {
          "_key": "e08885298e1b",
          "_type": "span",
          "marks": [],
          "text": "Data Ownership: You retain all rights to the data you upload or connect to Dashbud."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "913ec7288667",
      "_type": "block",
      "children": [
        {
          "_key": "e1aa6eea64c7",
          "_type": "span",
          "marks": [],
          "text": "Privacy: Dashbud does not expose your data to third-party AI models or use your data to train AI."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "868809a464eb",
      "_type": "block",
      "children": [
        {
          "_key": "74da8a034e16",
          "_type": "span",
          "marks": [],
          "text": "Security: Evolytix uses commercially reasonable measures to secure your data, but you are responsible for safeguarding access credentials."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "9732ef3566d9",
      "_type": "block",
      "children": [
        {
          "_key": "f434c9d2a41f",
          "_type": "span",
          "marks": [],
          "text": "4. Service Levels and Availability"
