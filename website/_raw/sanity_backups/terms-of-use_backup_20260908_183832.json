      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "f86d725351b1",
      "_type": "block",
      "children": [
        {
          "_key": "7a60b71ea042",
          "_type": "span",
          "marks": [],
          "text": "Dashbud is provided on an \u201cas is\u201d and \u201cas available\u201d basis. Evolytix will make commercially reasonable efforts to ensure uptime and support but does not guarantee uninterrupted service."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "385a074e7ce3",
      "_type": "block",
      "children": [
        {
          "_key": "9ec9b86732da",
          "_type": "span",
          "marks": [],
          "text": "5. Fees and Payment"
