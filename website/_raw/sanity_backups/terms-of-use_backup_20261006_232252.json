      "_type": "block",
      "children": [
        {
          "_key": "b59yucq2825b",
          "_type": "span",
          "marks": [],
          "text": "By accessing or using Dashbud's website and services, you agree to be bound by this Agreement. If you do not agree with any part of this Agreement, you must not use Dashbud."
        }
      ],
      "markDefs": [],
      "style": "normal"
