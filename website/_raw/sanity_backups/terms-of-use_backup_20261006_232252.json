      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "yu9zxsvi2z3q",
      "_type": "block",
      "children": [
        {
          "_key": "3ju3ddi4fgx3",
          "_type": "span",
          "marks": [],
          "text": "6. Term and Termination"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "md0nvvfdcao0",
      "_type": "block",
      "children": [
        {
          "_key": "7yr9hdrg0dd3",
          "_type": "span",
          "marks": [],
          "text": "This Agreement remains in effect until terminated. You may terminate at any time by ceasing use. Provider may suspend or terminate your license for violation of this Agreement. Upon termination, you must cease all use of Dashbud."
