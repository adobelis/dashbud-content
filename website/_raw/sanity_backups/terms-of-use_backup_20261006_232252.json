      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "0zwgcnii5wgi",
      "_type": "block",
      "children": [
        {
          "_key": "no2sko1y7f60",
          "_type": "span",
          "marks": [],
          "text": "Provider grants you a limited, non-exclusive, non-transferable, revocable license to access and use Dashbud solely for your internal business purposes and in accordance with this Agreement."
        }
