  "body": [
    {
      "_key": "fc84a56c7edd",
      "_type": "block",
      "children": [
        {
          "_key": "ff051a053d60",
          "_type": "span",
          "marks": [],
          "text": "Dashbud -- Privacy Policy"
        }
      ],
      "markDefs": [],
      "style": "h1"
    },
    {
      "_key": "516b593db7ff",
      "_type": "block",
      "children": [
        {
          "_key": "d11df781cf90",
          "_type": "span",
          "marks": [],
          "text": "1. Overview"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "3cb9c57d1947",
      "_type": "block",
      "children": [
        {
          "_key": "c7345ea3972d",
          "_type": "span",
          "marks": [],
          "text": "Evolytix, Inc. (\u201cEvolytix\u201d, \u201cwe\u201d, \u201cour\u201d, or \u201cus\u201d) is committed to protecting your privacy and your data. This Privacy Policy describes how Dashbud collects, uses, and safeguards information when you use our platform. It also explains what we do not do \u2014 most importantly, that Dashbud does not ingest or store any of your underlying data."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "0f0b62d40bc6",
      "_type": "block",
      "children": [
        {
          "_key": "9fc889999e99",
          "_type": "span",
          "marks": [],
          "text": "2. What We Collect"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "d822b95b22af",
      "_type": "block",
      "children": [
        {
          "_key": "5303b3336bd1",
          "_type": "span",
          "marks": [],
          "text": "When you use Dashbud, we collect only the information necessary to provide and improve our services. This includes:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "5eed1b6c20ea",
      "_type": "block",
      "children": [
        {
          "_key": "231142735469",
          "_type": "span",
          "marks": [],
          "text": "User Account Information: Name, email address, organization name, and authentication credentials."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "8aa5ff365af5",
      "_type": "block",
      "children": [
        {
          "_key": "8af01bd40e7b",
          "_type": "span",
          "marks": [],
          "text": "Connection Metadata: Information about the type of database you connect (e.g., SQL Server, Snowflake), including the schema, table names, column names, and data types."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "431ee3480d45",
      "_type": "block",
      "children": [
        {
          "_key": "d8db64b82d1c",
          "_type": "span",
          "marks": [],
          "text": "Usage Logs: Activity logs related to feature usage, error reporting, and system diagnostics (all anonymized or pseudonymized wherever possible)."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "65d3d0031b58",
      "_type": "block",
      "children": [
        {
          "_key": "5e6a3474e7c6",
          "_type": "span",
          "marks": [],
          "text": "3. What We Do Not Collect or Store"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "1c0b56a8748d",
      "_type": "block",
      "children": [
        {
          "_key": "e5ada9601908",
          "_type": "span",
          "marks": [],
          "text": "This is important:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "e617841e8841",
      "_type": "block",
      "children": [
        {
          "_key": "264f19993d0b",
          "_type": "span",
          "marks": [],
          "text": "Dashbud does NOT ingest or store your actual business data (i.e., the records, values, or contents in your database tables)."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "5519f92deafc",
      "_type": "block",
      "children": [
        {
          "_key": "420abbb5bdef",
          "_type": "span",
          "marks": [],
          "text": "Our platform only accesses database structure and metadata, such as:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "f49f845433fa",
      "_type": "block",
      "children": [
        {
          "_key": "8c2e93f4bf6b",
          "_type": "span",
          "marks": [],
          "text": "Table names"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "80779371685a",
      "_type": "block",
      "children": [
        {
          "_key": "3fe4587a5ec2",
          "_type": "span",
          "marks": [],
          "text": "Column names"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "21a517df63a0",
      "_type": "block",
      "children": [
        {
          "_key": "b4fb69a42016",
          "_type": "span",
          "marks": [],
          "text": "Column types"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "7828fea0369f",
      "_type": "block",
      "children": [
        {
          "_key": "bbb65099943b",
          "_type": "span",
          "marks": [],
          "text": "Relationships between tables (e.g., foreign keys)"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "418ead8abd70",
      "_type": "block",
      "children": [
        {
          "_key": "a9e4f0ce097f",
          "_type": "span",
          "marks": [],
          "text": "This metadata allows Dashbud to intelligently construct SQL queries based on your natural language questions \u2014 without ever exposing the underlying data to our systems or any third-party AI models."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "1b5a6fe939aa",
      "_type": "block",
      "children": [
        {
          "_key": "d7a304e8e867",
          "_type": "span",
          "marks": [],
          "text": "You maintain full control of your data. Dashbud acts as a query-generation layer on top of your existing data infrastructure."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "0c44d4877437",
      "_type": "block",
      "children": [
        {
          "_key": "92f046ffda72",
          "_type": "span",
          "marks": [],
          "text": "4. How We Use the Information"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "66e0296fa082",
      "_type": "block",
      "children": [
        {
          "_key": "c5381388ce84",
          "_type": "span",
          "marks": [],
          "text": "We use the information we collect strictly to:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "9678946cd60f",
      "_type": "block",
      "children": [
        {
          "_key": "217e0ab0c3ea",
          "_type": "span",
          "marks": [],
          "text": "Authenticate users and provide access to the Dashbud platform"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "d517a50d2416",
      "_type": "block",
      "children": [
        {
          "_key": "9437e8b35968",
          "_type": "span",
          "marks": [],
          "text": "Generate AI-assisted queries using your schema metadata"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "c43ed53f01f3",
      "_type": "block",
      "children": [
        {
          "_key": "8c47b80cb3e8",
          "_type": "span",
          "marks": [],
          "text": "Improve platform performance and reliability"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "266901eb1c4e",
      "_type": "block",
      "children": [
        {
          "_key": "333f417b3e0d",
          "_type": "span",
          "marks": [],
          "text": "Provide support and troubleshoot issues"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "acf213f70737",
      "_type": "block",
      "children": [
        {
          "_key": "51558dbdfe17",
          "_type": "span",
          "marks": [],
          "text": "Enforce our terms and protect against abuse"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "31795a3eb508",
      "_type": "block",
      "children": [
        {
          "_key": "2badba457b5b",
          "_type": "span",
          "marks": [],
          "text": "We do not use your information for advertising, resell it to third parties, or allow any third-party AI models (including LLMs) to access your schema or data."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "e1f0764cee94",
      "_type": "block",
      "children": [
        {
          "_key": "9dc71f156fe9",
          "_type": "span",
          "marks": [],
          "text": "5. Security and Data Access"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "93b9cd0315e4",
      "_type": "block",
      "children": [
        {
          "_key": "c09eb0e2e3dd",
          "_type": "span",
          "marks": [],
          "text": "We implement strong technical and organizational security measures, including:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "7186f4435958",
      "_type": "block",
      "children": [
        {
          "_key": "4d598e92b744",
          "_type": "span",
          "marks": [],
          "text": "Role-based access control"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "5febbf1c2049",
      "_type": "block",
      "children": [
        {
          "_key": "4436c3acf800",
          "_type": "span",
          "marks": [],
          "text": "Encrypted connections (TLS/SSL) for all data in transit"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "e869a682c681",
      "_type": "block",
      "children": [
        {
          "_key": "22f12e080928",
          "_type": "span",
          "marks": [],
          "text": "Logging and monitoring of access activity"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "666712441330",
      "_type": "block",
      "children": [
        {
          "_key": "54aed41266f7",
          "_type": "span",
          "marks": [],
          "text": "Only authorized personnel may access customer-specific metadata, and only for purposes directly related to support or diagnostics."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "ceb09b9f72b2",
      "_type": "block",
      "children": [
        {
          "_key": "4de397fffca5",
          "_type": "span",
          "marks": [],
          "text": "6. Third-Party Services"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "955c3a7e2ce5",
      "_type": "block",
      "children": [
        {
          "_key": "70492cc4fc6b",
          "_type": "span",
          "marks": [],
          "text": "Dashbud does not share any customer schema or metadata with external third-party services unless explicitly authorized by you, the customer. No analytics, ad platforms, or AI APIs process your data behind the scenes."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "fa36253f9bb2",
      "_type": "block",
      "children": [
        {
          "_key": "5d02c8c4e635",
          "_type": "span",
          "marks": [],
          "text": "7. Data Retention"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "118a5bf2141c",
      "_type": "block",
      "children": [
        {
          "_key": "924edce48e1f",
          "_type": "span",
          "marks": [],
          "text": "We retain user account data only for as long as your account remains active."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "d70add07c6fa",
      "_type": "block",
      "children": [
        {
          "_key": "6cc963d80c9d",
          "_type": "span",
          "marks": [],
          "text": "Schema metadata is retained temporarily to allow query generation but is never stored permanently unless you choose to save a dashboard or report."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "4ccbbb99e660",
      "_type": "block",
      "children": [
        {
          "_key": "5109ffd3adae",
          "_type": "span",
          "marks": [],
          "text": "You may request deletion of your account or any retained metadata at any time by contacting us."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "df968d52b8a2",
      "_type": "block",
      "children": [
        {
          "_key": "a9ba20bd4249",
          "_type": "span",
          "marks": [],
          "text": "8. Your Rights"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "d1d2b6f0f4e0",
      "_type": "block",
      "children": [
        {
          "_key": "b7cb068c6c6e",
          "_type": "span",
          "marks": [],
          "text": "You have the right to:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "de638b4ae670",
      "_type": "block",
      "children": [
        {
          "_key": "64e05f962b1a",
          "_type": "span",
          "marks": [],
          "text": "Request access to your user profile data"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "c45534d3c2f0",
      "_type": "block",
      "children": [
        {
          "_key": "21a08c10a1c9",
          "_type": "span",
          "marks": [],
          "text": "Request correction or deletion of your account information"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "c5830f98f296",
      "_type": "block",
      "children": [
        {
          "_key": "cfa4f6e4d1ac",
          "_type": "span",
          "marks": [],
          "text": "Withdraw consent for optional data processing (e.g., usage analytics)"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "48b1b04dfa16",
      "_type": "block",
      "children": [
        {
          "_key": "70df741b2981",
          "_type": "span",
          "marks": [],
          "text": "File a complaint with a regulatory authority, if applicable in your jurisdiction"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "37244d232f5b",
      "_type": "block",
      "children": [
        {
          "_key": "87a41910abd6",
          "_type": "span",
          "marks": [],
          "text": "9. Children\u2019s Privacy"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "783670a8fad3",
      "_type": "block",
      "children": [
        {
          "_key": "a19207110a62",
          "_type": "span",
          "marks": [],
          "text": "Dashbud is not intended for use by individuals under the age of 18. We do not knowingly collect personal information from children."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "a140822977e8",
      "_type": "block",
      "children": [
        {
          "_key": "4a6ae2d390e1",
          "_type": "span",
          "marks": [],
          "text": "10. Changes to This Policy"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "ea8590efd2b3",
      "_type": "block",
      "children": [
        {
          "_key": "770771974ca7",
          "_type": "span",
          "marks": [],
          "text": "We may update this Privacy Policy from time to time. When we do, we will revise the \"Last Updated\" date. Material changes will be communicated via email or dashboard notification."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "a3c67fc7b22f",
      "_type": "block",
      "children": [
        {
          "_key": "d34d19486641",
          "_type": "span",
          "marks": [],
          "text": "11. Contact Us"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "261f7b2874fa",
      "_type": "block",
      "children": [
        {
          "_key": "f20842d4a1e0",
          "_type": "span",
          "marks": [],
          "text": "For any questions or concerns about this Privacy Policy, please contact us at: hello@mail.getdashbud.com"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "7c4b4090d5ff",
      "_type": "block",
      "children": [
        {
          "_key": "cee937e35acc",
          "_type": "span",
          "marks": [],
          "text": ""
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "ffa6b920c66c",
      "_type": "block",
      "children": [
        {
          "_key": "b78e629eab32",
          "_type": "span",
          "marks": [],
          "text": "Dashbud lets you create reports and dashboards from your own data with a conversational UI."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "0384961146c8",
      "_type": "block",
      "children": [
        {
          "_key": "2229ec304cb8",
          "_type": "span",
          "marks": [],
          "text": ""
        }
      ],
      "markDefs": [],
      "style": "normal"
    }
  ],
